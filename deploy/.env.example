# -----------------------------------------------------------------------------
# Store Hub — production settings for deploy/docker-compose.yml.
# Copy to deploy/.env and fill in. NEVER commit deploy/.env.
# No quotes needed. Avoid "$" in values (or wrap the whole value in '...').
# -----------------------------------------------------------------------------

# --- Addresses ---------------------------------------------------------------
# Each needs a DNS A record pointing at this server. The Hub is the operator
# app; the Vetrina's address serves the Vetrina only (same login).
HUB_HOST=hub.resellpiacenza.shop
VETRINA_HOST=vetrina.resellpiacenza.shop

# The Docker network your caddy-docker-proxy container watches (the one named
# in its CADDY_INGRESS_NETWORKS).
CADDY_NETWORK=caddy

# --- Login (required) --------------------------------------------------------
# One shared password for both addresses, at least 8 characters. Changing it
# signs every device out.
APP_PASSWORD=

# --- Database (required) -----------------------------------------------------
# Generate it once:  openssl rand -hex 24
# Letters and digits only — it goes inside a URL. Postgres takes it when the
# database is first created; changing it here later is not enough.
POSTGRES_PASSWORD=

# --- WooCommerce REST: the Sync tab and the Vetrina --------------------------
# Read/Write key of a user with manage_woocommerce (the same as today).
WOO_BASE_URL=https://resellpiacenza.shop
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# --- Optional: uncomment the ones you use ------------------------------------
# Don't leave a line with nothing after "=": uncomment it with a value or not
# at all. Every variable is explained in the repo's .env.example.
# KICKS_SECRET=your-kicksdb-api-key
# GS_FEED_URL=https://www.goldensneakers.net/api/assortment-flat/?vat=22&markup=...
# GS_FEED_TOKEN=your-goldensneakers-bearer-token
# AUTO_REPAIR=on
# The daily sync runs inside the app (on by default in production).
# SCHEDULER=off
# CRON_SECRET=only-if-an-external-scheduler-calls-/api/cron
